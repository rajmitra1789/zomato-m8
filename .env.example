# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# The app runs without a key: the pipeline falls back to deterministic ranking with
# template explanations. Set this only when you want LLM-generated recommendations.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at an OpenAI-compatible provider instead.
# OPENAI_BASE_URL=https://api.example.com/v1

# Optional overrides. Every Settings field is available with the ZOMATO_ prefix.
# ZOMATO_LLM_MODEL=gpt-4o-mini
# ZOMATO_CANDIDATE_COUNT=20
# ZOMATO_RESULT_COUNT=5
# ZOMATO_MIN_VOTES_M=50
