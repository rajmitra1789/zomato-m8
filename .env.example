# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# The app runs without a key: the pipeline falls back to deterministic ranking with
# template explanations. Set this only when you want LLM-generated recommendations.
#
# Groq is the default provider (model openai/gpt-oss-120b). Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Optional: OPENAI_API_KEY is accepted as an alias for the same setting.
# OPENAI_API_KEY=gsk-your-key-here

# Optional: point the OpenAI-compatible client at a different host. Default is Groq.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional overrides. Every Settings field is available with the ZOMATO_ prefix.
# ZOMATO_LLM_MODEL=openai/gpt-oss-120b
# ZOMATO_REASONING_EFFORT=low
# ZOMATO_CANDIDATE_COUNT=20
# ZOMATO_RESULT_COUNT=5
# ZOMATO_MIN_VOTES_M=50
